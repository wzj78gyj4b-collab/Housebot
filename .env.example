# Telegram token from @BotFather (never commit the real token)
TELEGRAM_BOT_TOKEN=
# Google AI Studio API key (never commit the real key)
AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional NASA API key; defaults to DEMO_KEY (strict rate limits)
NASA_API_KEY=
# Optional comma-separated Telegram numeric user IDs allowed to use admin commands
TELEGRAM_ADMIN_IDS=
# Optional bot username without @, used to detect group mentions
TELEGRAM_BOT_USERNAME=
